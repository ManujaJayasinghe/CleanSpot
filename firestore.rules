rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 1. users: Users can read profiles, but only modify their own profile
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid);
    }

    // 2. reports: Public read for verified reports, submitters can create
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      // Allow updates for confirmations or status changes
      allow update: if isAuthenticated();
    }

    // 3. reportPhotos: Isolated image storage for reports (under 300KB)
    // List/querying is prevented; only single document read by ID is permitted
    match /reportPhotos/{reportId} {
      allow get: if isAuthenticated();
      allow list: if false; // Strict prohibition on bulk queries
      allow create: if isAuthenticated();
    }

    // 4. coupons: Read available coupons, updates handled atomically during redemption
    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 5. redemptions: Users can create and read their own redemptions
    match /redemptions/{redemptionId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }
  }
}

